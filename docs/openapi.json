  "components": {
    "schemas": {
      "ErrorFix": {
        "type": "object",
        "required": [
          "error_code",
          "description",
          "programmatic_fix"
        ],
        "properties": {
          "error_code": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "programmatic_fix": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "x-payment-methods": {
    "version": "1.0",
    "methods": [
      {
        "id": "bitcoin-lightning",
        "name": "Bitcoin Lightning",
        "provider": "Lightning Network",
        "protocol": "BOLT11 over HTTP 402",
        "network": "Bitcoin Lightning mainnet",
        "asset": "BTC (sats)",
        "flow": "http-402-retry",
        "audiences": [
          "agent",
          "human"
        ],
        "description": "Pay a BOLT11 invoice and retry with one-time settlement proof.",
        "enabled": true
      },
      {
        "id": "x402-solana-usdc",
        "name": "x402 USDC on Solana",
        "provider": "x402",
        "protocol": "x402 v2 exact",
        "network": "Solana mainnet",
        "asset": "USDC",
        "flow": "http-402-retry",
        "audiences": [
          "agent"
        ],
        "description": "Pay USDC through an x402 payment challenge and retry the request. No SOL required; facilitator handles network fees.",
        "enabled": true,
        "facilitator": "https://x402.dexter.cash",
        "purchase_endpoint": "/api/x402/agent-data",
        "audience": "agent",
        "sol_required": false
      },
      {
        "id": "stripe-checkout-card",
        "name": "Card payment",
        "provider": "Stripe Checkout",
        "protocol": "Stripe Checkout Session",
        "network": "Card networks",
        "asset": "USD",
        "flow": "hosted-checkout",
        "audiences": [
          "human",
          "agent"
        ],
        "description": "Pay by card in Stripe-hosted Checkout and redeem the resulting entitlement.",
        "enabled": true
      }
    ]
  }
}
