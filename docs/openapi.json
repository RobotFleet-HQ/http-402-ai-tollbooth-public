    "/api/preview": {
      "get": {
        "operationId": "previewDefaultProduct",
        "summary": "Preview api-error-fixes",
        "responses": {
          "200": {
            "description": "Three free records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Preview rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/preview/{product}": {
      "get": {
        "operationId": "previewProduct",
        "summary": "Preview a product",
        "parameters": [
          {
            "name": "product",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Product ID from /api/catalog"
          }
        ],
        "responses": {
          "200": {
            "description": "Exactly three free records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "upgrade_url",
                    "price_sats",
                    "message"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "required": [
                          "error_code",
                          "description",
                          "programmatic_fix"
                        ],
                        "properties": {
                          "error_code": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": {
                            "type": "string",
                            "minLength": 1
                          },
                          "programmatic_fix": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    "upgrade_url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "price_sats": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown product",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Preview rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
